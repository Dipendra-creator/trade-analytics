MYSQL_DATABASE=demo
MYSQL_USER=demo_user
MYSQL_PASSWORD=demo_password
MYSQL_ROOT_PASSWORD=root_password

# Generate these in Dhan Web / DhanHQ and rotate the access token as required.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
DHAN_BACKFILL_ENABLED=true
DHAN_LIVE_FEED_ENABLED=true
DHAN_BACKFILL_FROM=2026-07-01T09:15:00
# Optional; blank means up to the current time.
DHAN_BACKFILL_TO=

# Generate unique production values; never use the examples above outside local development.
SETTINGS_ADMIN_USERNAME=admin
SETTINGS_ADMIN_PASSWORD=
SETTINGS_ENCRYPTION_KEY=
ALLOWED_ORIGIN=https://nse.revvlabs.tech
PAPER_TRADING_ENABLED=true
PAPER_STARTING_CAPITAL=1000000
PAPER_RISK_PER_TRADE=0.01
PAPER_MAX_OPEN_POSITIONS=5
PAPER_MAX_DAILY_LOSS=0.03
PAPER_MAX_HOLD_MINUTES=30
PAPER_SLIPPAGE_BPS=5
PAPER_TRANSACTION_COST_BPS_PER_SIDE=8
